<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="res_config_settings_view_form_pos">
            <field name="name">res.config.settings.form.pos</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_interface_section']" position="inside">
                    <setting id="restrict_zero_qty" string="Restrict Zero Product Quantity"
                             help="Prevent adding products to the order if their available stock is zero or less.">
                        <field name="pos_prod_zero_qty_restrict"/>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
