<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- User Group -->
    <record id="group_inter_company_transfer_user" model="res.groups">
        <field name="name">Inter-Company Transfer / User</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <!-- Manager Group -->
    <record id="group_inter_company_transfer_manager" model="res.groups">
        <field name="name">Inter-Company Transfer / Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_inter_company_transfer_user'))]"/>
    </record>

    <!-- Record rule: users only see transfers involving their own companies -->
    <record id="rule_inter_company_transfer_company" model="ir.rule">
        <field name="name">Inter-Company Transfer: Company Access</field>
        <field name="model_id" ref="model_inter_company_transfer"/>
        <field name="domain_force">
            ['|',
             ('source_company_id', 'in', company_ids),
             ('destination_company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('group_inter_company_transfer_user'))]"/>
    </record>

</odoo>