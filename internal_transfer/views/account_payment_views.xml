<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         FORM VIEW — Internal Transfer checkbox + Destination Journal
    ============================================================ -->
    <record id="view_account_payment_internal_transfer_form" model="ir.ui.view">
        <field name="name">account.payment.internal.transfer.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='payment_type']" position="before">
                <field name="is_internal_transfer"
                       widget="boolean_toggle"
                       string="Internal Transfer"/>
            </xpath>

            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="destination_journal_id"
                       invisible="not is_internal_transfer"
                       required="is_internal_transfer"
                       options="{'no_create': True}"/>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         SEARCH VIEW
    ============================================================ -->
    <record id="view_account_payment_internal_transfer_search" model="ir.ui.view">
        <field name="name">account.payment.internal.transfer.search</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">

            <!-- Exclude internal transfers from Customer Payments filter -->
            <xpath expr="//filter[@name='inbound_filter']" position="replace">
                <filter name="inbound_filter"
                        string="Customer Payments"
                        domain="[('partner_type','=','customer'),('is_internal_transfer','=',False)]"/>
            </xpath>

            <!-- Exclude internal transfers from Vendor Payments filter -->
            <xpath expr="//filter[@name='outbound_filter']" position="replace">
                <filter name="outbound_filter"
                        string="Vendor Payments"
                        domain="[('partner_type','=','supplier'),('is_internal_transfer','=',False)]"/>
                <!-- Add Internal Transfers filter right after Vendor Payments -->
                <filter name="internal_transfer"
                        string="Internal Transfers"
                        domain="[('is_internal_transfer','=',True)]"/>
            </xpath>

        </field>
    </record>

</odoo>